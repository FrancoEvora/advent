import test from 'node:test';
import assert from 'node:assert/strict';
import { canonical, cleanReply, replyText, replayOutput, toolCalls, phone, evidencedContact, safeFilters, compactCommercial, cheapestUnit, bestScenario, simulationSummary, errorKind, dateWithZone, safeExternalUrl } from '../supabase/functions/enterprise-bia-agent-gateway/core';
const call=(id:string,name='consultar_estoque',args='{}')=>({type:'function_call',call_id:id,name,arguments:args});
test('every function call receives a unique parsed item',()=>{const c=toolCalls({output:[call('a'),call('b','simular_pagamento'),call('a')]});assert.deepEqual(c.map(x=>x.callId),['a','b']);});
test('malformed JSON and arrays are invalid, not empty valid tool actions',()=>{assert.equal(toolCalls({output:[call('a','x','bad')]} )[0].invalid,true);assert.equal(toolCalls({output:[call('b','x','[]')]} )[0].invalid,true);});
test('equivalent argument order uses same cache key',()=>{assert.equal(canonical({b:1,a:2}),canonical({a:2,b:1}));});
test('stateless replay preserves all tool calls and encrypted reasoning without server file-search IDs',()=>{const r=replayOutput({output:[{type:'reasoning',id:'rs1',encrypted_content:'cipher',summary:[]},{type:'file_search_call',id:'fs1'},call('a'),call('b'),{type:'message',id:'m1',content:[{type:'output_text',text:'Resultado'}]}]});assert.equal(r.length,4);assert.equal(r.filter(x=>x.type==='function_call').length,2);assert.equal(JSON.stringify(r).includes('fs1'),false);assert.equal(r[0].encrypted_content,'cipher');});
test('all response blocks preserved, no silent 1200 character clipping',()=>{const long='x'.repeat(1300);assert.equal(cleanReply(long).length,1300);assert.equal(replyText({output:[{type:'message',content:[{type:'output_text',text:'Um'},{type:'output_text',text:'Dois'}]}]}),'Um\n\nDois');});
test('plain text removes visible Markdown',()=>assert.equal(cleanReply('## Teste\n**Lote**\n- IPCA'),'Teste\nLote\n• IPCA'));
test('Brazil phone handles country prefix and DDD 55 without eating the DDD',()=>{assert.equal(phone('(55) 99999-8888'),'+5555999998888');assert.equal(phone('+55 (34) 99999-8888'),'+5534999998888');assert.equal(phone('123'),null);});
test('contact cannot be invented from model arguments',()=>{assert.deepEqual(evidencedContact({name:'Ana',phone:'34999998888'},['Bom dia']),{});assert.deepEqual(evidencedContact({name:'Ana',phone:'34999998888'},['Ana. WhatsApp (34) 99999-8888']),{name:'Ana',phone:'+5534999998888'});});
test('ERP filters use exact canonical names and reject swapped range',()=>{assert.deepEqual(safeFilters({unit_code:'sol-c-04',budget_max:500000}),{unitCode:'SOL-C-04',areaMin:null,areaMax:null,budgetMax:500000,limit:6});assert.throws(()=>safeFilters({area_min:500,area_max:300}));});
test('commercial parameters do not reveal internal metadata',()=>{const c=compactCommercial({policy:{parameters:{internal_margin:0.8,plan_options:[150]}},units:[]});assert.deepEqual((c!.policy as Record<string, unknown>).parameters,{plan_options:[150]});});
test('cheapest unit and minimum calculated scenario reject invalid values',()=>{assert.equal(cheapestUnit({units:[{unit_code:'SOL-C-01',list_price:NaN},{unit_code:'SOL-C-02',list_price:450},{unit_code:'SOL-C-03',list_price:900}]}),'SOL-C-02');assert.equal(bestScenario({scenarios:[{monthlyPayment:-2,months:150},{monthlyPayment:3,months:120},{monthlyPayment:2,months:150}]})!.monthlyPayment,2);});
test('baseline minimum is expressly bounded, never absolute or approved',()=>{const s=simulationSummary({unitCode:'SOL-C-04',area:360,price:450000,downPayment:45000,downPaymentInstallments:1,monthlyInterestRate:.0033,indexer:'IPCA',balloonCount:0,scenarios:[{months:150,monthlyPayment:3427.52}]})!;assert.match(s,/entre os prazos calculados/);assert.match(s,/sem balões/);assert.match(s,/indicativa/);});
test('provider quota never blames visitor for excessive messages',()=>{assert.equal(errorKind(429,'credit_balance_exhausted').code,'BIA_PROVIDER_QUOTA');assert.equal(errorKind(429,'rate_limit_exceeded').code,'BIA_PROVIDER_BUSY');assert.equal(errorKind(429,'rate_limit_exceeded').status,503);});
test('visit needs timezone and future time',()=>{const now=Date.parse('2026-09-04T12:00:00Z');assert.equal(dateWithZone('2026-09-05T10:00:00',now),null);assert.equal(dateWithZone('2026-09-05T10:00:00-03:00',now),'2026-09-05T13:00:00.000Z');assert.equal(dateWithZone('2026-09-04T08:00:00-03:00',now),null);});
test('materials reject javascript and local URLs',()=>{assert.equal(safeExternalUrl('javascript:alert(1)'),null);assert.equal(safeExternalUrl('https://127.0.0.1/x'),null);assert.equal(safeExternalUrl('https://example.com/file.pdf'),'https://example.com/file.pdf');});
