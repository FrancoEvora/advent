# Supabase criado para a Évora Gestão
NEXT_PUBLIC_SUPABASE_URL=https://qsdffayasuzsmngteika.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_A_CHAVE_PUBLICAVEL_DO_SUPABASE_AQUI

# Exclusiva do servidor: nunca use prefixo NEXT_PUBLIC nem exponha no navegador.
# Necessária para alteração administrativa de senhas, exclusão de usuários e OTP.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_CHAVE_SERVICE_ROLE_DO_SUPABASE_AQUI

# Hub Meta Lead Ads — o App Secret e os tokens devem ser cadastrados pela tela
# de integração do Évora e permanecem no Vault do Supabase.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Prefira a nova Secret Key. SUPABASE_SERVICE_ROLE_KEY permanece como fallback.
SUPABASE_SECRET_KEY=COLE_A_SECRET_KEY_DO_SUPABASE_AQUI
# Fallback legado somente para bootstrap anterior à migration do cofre. Deixe
# false em produção após o Vault estar disponível; revogar no Évora nunca
# reativa silenciosamente uma credencial de ambiente.
META_CREDENTIALS_ENV_FALLBACK=false
META_APP_SECRET=COLE_O_APP_SECRET_DA_META_AQUI
META_WEBHOOK_VERIFY_TOKEN=CRIE_UM_TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES
META_GRAPH_API_VERSION=v26.0
# Token global de contingência para páginas não presentes no mapa abaixo.
META_LEADS_ACCESS_TOKEN=COLE_O_PAGE_OU_SYSTEM_USER_ACCESS_TOKEN_AQUI
# Opcional: tokens diferentes por página, em JSON. Nunca prefixe com NEXT_PUBLIC.
META_PAGE_ACCESS_TOKENS_JSON={"123456789012345":"TOKEN_DA_PAGINA_SOLARIS"}
META_DEFAULT_COUNTRY_CODE=55
# Somente estas chaves explícitas de disclaimer podem conceder consentimento.
META_MARKETING_CONSENT_CHECKBOX_KEYS=aceite_comunicacoes

# /api/integrations/meta/leads/process usa URL e segredo internos mantidos no
# Vault pelo banco. Nenhum segredo do worker e configurado no frontend/Vercel.
META_LEADS_BATCH_SIZE=10
META_LEADS_LEASE_SECONDS=120
META_LEADS_CONCURRENCY=3
META_GRAPH_TIMEOUT_MS=12000

# Agente comercial IA — primeira etapa exclusivamente em modo sombra.
# Mantenha false até a migration crm_ai_shadow_agent_foundation estar aplicada,
# OPENAI_API_KEY e o token do worker estarem configurados e o preview validado.
CRM_AI_SHADOW_ENABLED=false
OPENAI_API_KEY=COLE_A_CHAVE_OPENAI_SOMENTE_NO_SERVIDOR
OPENAI_AGENT_MODEL=gpt-5.6
OPENAI_SUPERVISOR_MODEL=gpt-5.6
OPENAI_REQUEST_TIMEOUT_MS=25000
CRM_AI_BATCH_SIZE=5
CRM_AI_LEASE_SECONDS=180
CRM_AI_CONCURRENCY=2
# Segredo para POST /api/ai/leads/process. CRON_SECRET pode ser usado como
# fallback no futuro, quando o worker for promovido a cron.
CRM_AI_WORKER_TOKEN=CRIE_UM_TOKEN_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
